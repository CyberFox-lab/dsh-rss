{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "composite": false,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/client", "tests"]
}
